# Copy this file to .env and fill in what you need. .env is never committed.
#
#   cp .env.example .env
#
# Docker Compose reads .env by itself (docker compose up, make up). With uv, pass it:
#
#   uv run --env-file .env egms releases
#
# Values with spaces go in double quotes. Every setting has a default: an empty
# line means "the default".

# --- The CLMS key (needed for real data) ------------------------------------
# A service key from land.copernicus.eu: profile -> API Tokens -> Create new token
# (see the README, "Get a service key"). Keep the JSON out of the repository:
# ./secrets/ and *service-key*.json are ignored by git and by Docker.
#
# Without Docker: the path of the JSON. One underscore: EGMS_SERVICE_KEY_FILE
# (Limen uses EGMS__SERVICE_KEY_FILE, with two: a different variable).
EGMS_SERVICE_KEY_FILE=./secrets/clms_service_key.json
# Or the JSON itself, on one line (CI secrets, containers). Wins over the file.
EGMS_SERVICE_KEY=
# With Docker: the folder mounted read-only at /run/secrets/egms, and the name of
# the JSON in it. The key is never copied into an image.
EGMS_SECRETS_DIR=./secrets
EGMS_SERVICE_KEY_NAME=clms_service_key.json

# Where downloads are kept, without Docker (default: ~/.cache/egms-client).
# With Docker they go to the volume egms-data.
EGMS_DATA_DIR=

# --- The page of a Comune (docker compose up: http://127.0.0.1:3003) -------
# Where the map opens, in decimal degrees: here Pozzuoli, which is also the
# default. Write those of your place.
EGMS_UI_LAT=40.8225
EGMS_UI_LON=14.1205
# The zoom it opens at, 6 to 17 (default 13).
EGMS_UI_ZOOM=
# The name in the header.
EGMS_UI_PLACE="Comune di Pozzuoli"
# The language: it or en (default it). The visitor can switch.
EGMS_UI_LANG=it
# Who may show the page in an iframe, as a CSP frame-ancestors list, such as
# "https://www.comune.pozzuoli.na.it". Default: this site only.
EGMS_UI_FRAME_ANCESTORS=
# The tiles of the background map, and their credit (default: OpenStreetMap,
# which then sees the address of every visitor).
EGMS_UI_TILES=
EGMS_UI_TILES_CREDIT=
# Where the data come from: archive (needs the key) or demo (the crops of the
# benchmark, offline). Default: archive when a key is found, else demo.
EGMS_UI_SOURCE=
# The folder of the crops in demo mode (default: benchmarks/data).
EGMS_UI_CROPS=
# L3 tiles one answer may download at most, about 60 MB each (default 4).
EGMS_UI_MAX_TILES=
# The folder of your records (opendata-record/v1, .json or .jsonl): a sensor, a
# file of the Comune. Read-only in the container; the page shows them next to
# EGMS. Check a file with: egms records FILE
EGMS_RECORDS_DIR=

# --- Ports (all on 127.0.0.1) ----------------------------------------------
# The page (default 3003).
EGMS_UI_PORT=
# JupyterLab, with: docker compose --profile notebook up (default 8889).
EGMS_NOTEBOOK_PORT=
# The MCP server over HTTP, with: docker compose --profile mcp up (default 8768).
EGMS_MCP_PORT=
# The token of JupyterLab. Empty: a random one, printed by `make logs`.
EGMS_NOTEBOOK_TOKEN=

# --- AI (optional, paid) -----------------------------------------------------
# The key of the Claude API, only for `python -m benchmarks.faithful ask` and
# `label`. Without it nothing calls a model; with it, every call costs money.
ANTHROPIC_API_KEY=
